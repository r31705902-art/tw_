# ---- telegram ----
TG_BOT_TOKEN=
TG_CHAT_ID=

# ---- llm providers ----
# openrouter: several keys, comma separated, rotated per request
OPENROUTER_KEYS=

# nvidia NIM (https://integrate.api.nvidia.com)
NVIDIA_API_KEY=

# token harbor (openai-compatible gateway) - base url is provider specific
TOKENHARBOR_API_KEY=
TOKENHARBOR_BASE_URL=https://api.tokenharbor.ai/v1

# opencode zen - documented as requiring no api key
OPENCODE_ZEN_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_ZEN_API_KEY=

# default agent model: "<provider>:<model>"
AGENT_MODEL=openrouter:nvidia/nemotron-3.5-lightning:free
AGENT_MAX_TURNS=30
AGENT_TEMPERATURE=0.2

# ---- workspace / state ----
DATA_DIR=./data
WORKSPACE_DIR=.

# ---- oxylabs residential proxy ----
OXY_USERNAME=resi_eb37f2a3
OXY_PASSWORD=~O6EWlUFUSf+
OXY_HOST=pr.oxylabs.io
OXY_PORT=7777
# sticky session id, minutes, country pin (empty = any)
OXY_SESSION=0761429127
OXY_SESSTIME=10
OXY_COUNTRY=
OXY_CITY=
OXY_PROTOCOL=http

# datacenter fallback list (committed in this repo)
DC_PROXY_FILE=proxies.txt

# notify policy: which levels push to telegram
NOTIFY_LEVELS=info,warn,error,critical
